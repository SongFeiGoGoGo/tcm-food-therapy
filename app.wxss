/**app.wxss — 全局样式：干净可读**/
page {
  background-color: #F7F4EF;
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.container {
  padding: 24rpx 32rpx 48rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A3420;
  margin-bottom: 12rpx;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.btn-primary {
  background: #6B4F2A;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background: #fff;
  color: #6B4F2A;
  border: 2rpx solid #6B4F2A;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 36rpx;
}

.btn-outline::after {
  border: none;
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B4F2A;
  margin: 24rpx 0 12rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #9ca3af;
}
