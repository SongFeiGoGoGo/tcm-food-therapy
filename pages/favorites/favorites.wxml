<view class="container">
  <view class="hint muted" wx:if="{{cloudReady}}">数据来自云数据库</view>
  <view class="hint muted" wx:else>数据保存在本机（本地演示模式）</view>

  <view class="card fav-item" wx:for="{{list}}" wx:key="_id" bindtap="onTapItem" data-id="{{item.recipeId}}">
    <view class="card-title">{{item.title}}</view>
    <view class="muted" wx:if="{{item.symptomName}}">症状：{{item.symptomName}}</view>
    <view class="muted" wx:elif="{{item.subtitle}}">{{item.subtitle}}</view>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">
    <view>还没有收藏</view>
    <navigator url="/pages/notes/notes" open-type="switchTab" class="back-link">去笔记看看</navigator>
  </view>

  <view class="disclaimer">理性讨论，不替代面诊</view>
</view>
