.mine-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #e7f3ec 0%, #f7f7f5 42%);
}

.mine-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.mine-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1b4332;
  margin-bottom: 12rpx;
}

.mine-desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.btn-block {
  width: 100%;
}

.hook {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.55;
}

.avatar-slot {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e7f3ec;
  position: relative;
}

.avatar-btn {
  position: absolute;
  left: 0;
  top: 0;
  width: 160rpx !important;
  height: 160rpx !important;
  min-height: 0;
  padding: 0 !important;
  margin: 0 !important;
  border: none;
  border-radius: 50%;
  overflow: hidden;
  background: #e7f3ec;
  line-height: 160rpx;
  font-size: 0;
}

.avatar-btn::after {
  border: none;
  display: none;
}

.avatar {
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50%;
  display: block;
}

.avatar-hint {
  text-align: center;
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 28rpx;
}

.nick-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.nick {
  font-size: 36rpx;
  font-weight: 700;
  color: #1b4332;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-link {
  color: #2d6a4f;
  font-size: 26rpx;
  padding: 8rpx 4rpx;
}

.nick-edit {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nick-input {
  flex: 1;
  min-width: 0;
  background: #f3f7f4;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.nick-save {
  flex-shrink: 0;
  width: auto;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
}

.logout {
  margin-top: 28rpx;
  width: 100%;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  color: #1b4332;
  font-size: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.menu-arrow {
  color: #9ca3af;
  font-size: 40rpx;
  line-height: 1;
}
