.header-card .title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1b4332;
  margin: 8rpx 0;
}

.subtitle {
  font-size: 26rpx;
  color: #4b5563;
}

.symptom-chip {
  display: inline-block;
  font-size: 22rpx;
  color: #2d6a4f;
  background: #e8f5e9;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #374151;
  background: #f3f4f6;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.ingredient {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.ingredient:last-child {
  border-bottom: none;
}

.ing-name {
  color: #1a1a1a;
}

.ing-amount {
  color: #2d6a4f;
  font-weight: 500;
}

.body-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.7;
}

.step {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #374151;
}

.step-num {
  color: #2d6a4f;
  font-weight: 600;
  flex-shrink: 0;
}

.note {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.note-dot {
  color: #2d6a4f;
  font-weight: 700;
}

.actions {
  margin: 32rpx 0 8rpx;
}

.fav-btn {
  width: 100%;
}

.btn-danger {
  background: #fff;
  color: #b91c1c;
  border: 2rpx solid #fecaca;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 36rpx;
  margin-top: 20rpx;
}

.btn-danger::after {
  border: none;
}

.hide-row {
  margin-top: 28rpx;
  text-align: center;
}

.hide-link {
  font-size: 24rpx;
  color: #9ca3af;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}
