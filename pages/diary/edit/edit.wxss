.edit-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
  background: #F7F4EF;
  box-sizing: border-box;
}

.field {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3420;
  margin-bottom: 16rpx;
}

.opt {
  font-weight: 400;
  font-size: 22rpx;
  color: #9ca3af;
  margin-left: 8rpx;
}

.picker-val {
  font-size: 28rpx;
  color: #1a1a1a;
  padding: 8rpx 0;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B4F2A;
  background: #F6F1EA;
  border: 2rpx solid transparent;
}

.chip.on {
  background: #6B4F2A;
  color: #fff;
  border-color: #6B4F2A;
}

.input {
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  background: #F7F4EF;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx 20rpx;
  background: #F7F4EF;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-block {
  width: 100%;
  margin-top: 12rpx;
}

.btn-danger {
  background: #fff;
  color: #b91c1c;
  border: 2rpx solid #fecaca;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 36rpx;
  margin-top: 20rpx;
}

.btn-danger::after {
  border: none;
}
