<view class="diary-page" bindtap="onPageTap">
  <view class="diary-hero">
    <view class="diary-badge">个人记录</view>
    <view class="diary-title">养生日记</view>
    <view class="diary-desc">记下睡、便、口味、情绪等日常感觉，方便自己回顾。只做记录与简单计数，不做辨证或用药建议。</view>
  </view>

  <view class="summary-card" wx:if="{{!empty}}">
    <view class="summary-head">本周小结</view>
    <view class="summary-sub muted">{{summary.weekStart}} 起 · 仅计数</view>
    <scroll-view class="summary-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="summary-chip">
        <text class="summary-num">{{summary.recordCount}}</text>
        <text class="summary-label">记录</text>
      </view>
      <view class="summary-chip">
        <text class="summary-num">{{summary.dryThroatCount}}</text>
        <text class="summary-label">口干</text>
      </view>
      <view class="summary-chip">
        <text class="summary-num">{{summary.acneCount}}</text>
        <text class="summary-label">有痘</text>
      </view>
      <view class="summary-chip">
        <text class="summary-num">{{summary.poorSleepCount}}</text>
        <text class="summary-label">睡差</text>
      </view>
      <view class="summary-chip" wx:if="{{summary.coldCount}}">
        <text class="summary-num">{{summary.coldCount}}</text>
        <text class="summary-label">怕冷</text>
      </view>
      <view class="summary-chip" wx:if="{{summary.heatCount}}">
        <text class="summary-num">{{summary.heatCount}}</text>
        <text class="summary-label">怕热</text>
      </view>
    </scroll-view>
  </view>

  <view class="toolbar">
    <button class="btn-primary btn-add" catchtap="onAdd">写一条日记</button>
  </view>

  <view class="empty" wx:if="{{empty}}">
    <view>还没有日记</view>
    <view class="muted" style="margin-top:12rpx;">点上方按钮，记下今天的感觉吧</view>
  </view>

  <view
    class="swipe-row"
    wx:for="{{entries}}"
    wx:key="id"
  >
    <view class="swipe-actions">
      <view
        class="swipe-btn swipe-btn-del"
        data-id="{{item.id}}"
        catchtap="onDeleteItem"
      >删除</view>
    </view>
    <view
      class="swipe-content entry-card {{item._dragging ? 'is-dragging' : ''}}"
      style="transform: translateX({{item._x || 0}}px);"
      data-id="{{item.id}}"
      data-index="{{index}}"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchCancel"
      catchtouchmove="{{item._catchMove ? 'onCatchTouchMove' : ''}}"
      catchtap="onTapItem"
    >
      <view class="entry-date">{{item.date}}</view>
      <view class="entry-preview">
        <text wx:if="{{item.sleep}}">睡·{{item.sleep}}</text>
        <text wx:if="{{item.sleep && item.stool}}"> · </text>
        <text wx:if="{{item.stool}}">便·{{item.stool}}</text>
        <text wx:if="{{(item.sleep || item.stool) && item.mood}}"> · </text>
        <text wx:if="{{item.mood}}">情绪·{{item.mood}}</text>
        <text wx:if="{{(item.sleep || item.stool || item.mood) && item.dryThroat === '有'}}"> · </text>
        <text wx:if="{{item.dryThroat === '有'}}">嗓子干</text>
        <text wx:if="{{(item.sleep || item.stool || item.mood || item.dryThroat === '有') && item.acne === '有'}}"> · </text>
        <text wx:if="{{item.acne === '有'}}">有痘</text>
        <text wx:if="{{!(item.sleep || item.stool || item.mood || item.dryThroat === '有' || item.acne === '有')}}" class="muted">（可补充）</text>
      </view>
    </view>
  </view>

  <view class="disclaimer">理性讨论，不替代面诊。日记仅供个人回顾，不作诊断或用药依据。</view>
</view>
