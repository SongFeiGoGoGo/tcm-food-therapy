<view class="checkin-page">
  <view class="checkin-hero">
    <view class="checkin-badge">个人记录</view>
    <view class="checkin-title">打卡</view>
    <view class="checkin-desc">五个日常习惯，做了就勾上。格子颜色表示当天完成了几项。</view>
  </view>

  <view class="heat-card">
    <view class="heat-head">近 {{weeks.length}} 周</view>
    <view class="heat-body">
      <view class="heat-labels">
        <view class="heat-label-gap"></view>
        <view class="heat-label" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
      </view>
      <scroll-view
        class="heat-scroll"
        scroll-x
        enable-flex
        scroll-into-view="{{lastWeekId}}"
        scroll-with-animation="{{false}}"
      >
        <view class="heat-cols">
          <view class="heat-col" wx:for="{{weeks}}" wx:key="id" id="{{item.id}}">
            <view class="heat-month">{{item.monthText}}</view>
            <view
              wx:for="{{item.days}}"
              wx:for-item="day"
              wx:key="date"
              class="heat-cell lv{{day.level}} {{day.future ? 'is-future' : ''}} {{selected === day.date ? 'is-on' : ''}}"
              data-date="{{day.date}}"
              data-future="{{day.future}}"
              catchtap="onPickDay"
            ></view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="heat-legend">
      <text class="legend-word">少</text>
      <view class="heat-cell lv{{item}}" wx:for="{{levels}}" wx:key="*this"></view>
      <text class="legend-word">多</text>
    </view>
  </view>

  <view class="day-card" wx:if="{{selected}}">
    <view class="day-head">
      <text class="day-title">{{selectedLabel}}</text>
      <text class="day-count">{{doneCount}}/5</text>
    </view>
    <view
      class="habit-row"
      wx:for="{{habitRows}}"
      wx:key="key"
      data-key="{{item.key}}"
      catchtap="onToggle"
    >
      <view class="habit-box {{item.checked ? 'is-on' : ''}}"></view>
      <text class="habit-label">{{item.label}}</text>
    </view>
  </view>

  <view class="disclaimer">理性讨论，不替代面诊。这里只记个人习惯，不作诊疗依据。</view>
</view>
