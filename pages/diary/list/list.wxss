.checkin-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: linear-gradient(180deg, #eaf4ef 0%, #f7f7f5 40%);
  box-sizing: border-box;
}

.checkin-hero {
  background: #f0faf4;
  border: 2rpx solid #c5e0d0;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.checkin-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #1b5e3b;
  background: #c8e6d4;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.checkin-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1b4332;
  margin-bottom: 12rpx;
}

.checkin-desc {
  font-size: 24rpx;
  color: #4a6b58;
  line-height: 1.55;
}

.heat-card,
.day-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.heat-head,
.day-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b4332;
}

.heat-body {
  display: flex;
  margin-top: 16rpx;
}

.heat-labels {
  flex-shrink: 0;
  width: 36rpx;
  margin-right: 8rpx;
}

.heat-label-gap {
  height: 32rpx;
}

.heat-label {
  height: 44rpx;
  line-height: 44rpx;
  font-size: 18rpx;
  color: #9ca3af;
  margin-bottom: 6rpx;
}

.heat-scroll {
  flex: 1;
  height: 400rpx;
  white-space: nowrap;
}

.heat-cols {
  display: inline-flex;
  flex-direction: row;
  height: 400rpx;
}

.heat-col {
  display: inline-flex;
  flex-direction: column;
  width: 44rpx;
  margin-right: 8rpx;
}

.heat-month {
  height: 32rpx;
  line-height: 32rpx;
  font-size: 18rpx;
  color: #6b7280;
  white-space: nowrap;
}

.heat-cell {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  margin-bottom: 6rpx;
  box-sizing: border-box;
}

.lv0 { background: #e7f2ec; }
.lv1 { background: #c6e5d4; }
.lv2 { background: #8dceaf; }
.lv3 { background: #52b788; }
.lv4 { background: #2d6a4f; }
.lv5 { background: #1b4332; }

.heat-cell.is-future {
  background: #f3f4f6;
}

.heat-cell.is-on {
  box-shadow: inset 0 0 0 3rpx #1b4332;
}

.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.legend-word {
  font-size: 20rpx;
  color: #9ca3af;
  margin: 0 8rpx;
}

.heat-legend .heat-cell {
  width: 22rpx;
  height: 22rpx;
  margin: 0 4rpx 0 0;
}

.day-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.day-count {
  font-size: 26rpx;
  color: #2d6a4f;
  font-weight: 600;
}

.habit-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 2rpx solid #f3f4f6;
}

.habit-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #9ca3af;
  margin-right: 16rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.habit-box.is-on {
  background: #2d6a4f;
  border-color: #2d6a4f;
}

.habit-label {
  font-size: 30rpx;
  color: #1b4332;
}
