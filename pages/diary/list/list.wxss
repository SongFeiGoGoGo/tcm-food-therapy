.checkin-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: linear-gradient(180deg, #F6F1EA 0%, #F7F4EF 40%);
  box-sizing: border-box;
}

.checkin-hero {
  background: #F8F3EA;
  border: 2rpx solid #E2D0B8;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.checkin-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #6B4F2A;
  background: #EADCC8;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.checkin-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A3420;
  margin-bottom: 12rpx;
}

.checkin-desc {
  font-size: 24rpx;
  color: #7A6548;
  line-height: 1.55;
}

.heat-card,
.day-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.heat-head,
.day-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A3420;
}

.heat-body {
  display: flex;
  margin-top: 16rpx;
}

.heat-labels {
  flex-shrink: 0;
  width: 36rpx;
  margin-right: 8rpx;
}

.heat-label-gap {
  height: 32rpx;
}

.heat-label {
  height: 44rpx;
  line-height: 44rpx;
  font-size: 18rpx;
  color: #9ca3af;
  margin-bottom: 6rpx;
}

.heat-scroll {
  flex: 1;
  height: 400rpx;
  white-space: nowrap;
}

.heat-cols {
  display: inline-flex;
  flex-direction: row;
  height: 400rpx;
}

.heat-col {
  display: inline-flex;
  flex-direction: column;
  width: 44rpx;
  margin-right: 8rpx;
}

.heat-month {
  height: 32rpx;
  line-height: 32rpx;
  font-size: 18rpx;
  color: #6b7280;
  white-space: nowrap;
}

.heat-cell {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  margin-bottom: 6rpx;
  box-sizing: border-box;
}

.lv0 { background: #F3EBE1; }
.lv1 { background: #E4D0B8; }
.lv2 { background: #C4A484; }
.lv3 { background: #A67C52; }
.lv4 { background: #6B4F2A; }
.lv5 { background: #4A3420; }

.heat-cell.is-future {
  background: #f3f4f6;
}

.heat-cell.is-on {
  box-shadow: inset 0 0 0 3rpx #4A3420;
}

.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.legend-word {
  font-size: 20rpx;
  color: #9ca3af;
  margin: 0 8rpx;
}

.heat-legend .heat-cell {
  width: 22rpx;
  height: 22rpx;
  margin: 0 4rpx 0 0;
}

.day-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.day-count {
  font-size: 26rpx;
  color: #6B4F2A;
  font-weight: 600;
}

.habit-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.habit-row {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx 16rpx 0;
}

.habit-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #9ca3af;
  margin-right: 16rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.habit-box.is-on {
  background: #6B4F2A;
  border-color: #6B4F2A;
}

.habit-label {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.35;
  color: #4A3420;
}
