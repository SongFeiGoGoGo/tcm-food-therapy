.diary-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: linear-gradient(180deg, #eaf4ef 0%, #f7f7f5 40%);
  box-sizing: border-box;
}

.diary-hero {
  background: #f0faf4;
  border: 2rpx solid #c5e0d0;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.diary-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #1b5e3b;
  background: #c8e6d4;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.diary-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1b4332;
  margin-bottom: 12rpx;
}

.diary-desc {
  font-size: 24rpx;
  color: #4a6b58;
  line-height: 1.55;
}

.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 0 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.summary-head {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b4332;
  padding: 0 28rpx;
}

.summary-sub {
  margin-top: 6rpx;
  margin-bottom: 16rpx;
  padding: 0 28rpx;
}

.summary-scroll {
  white-space: nowrap;
  display: flex;
  flex-direction: row;
  width: 100%;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.summary-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 148rpx;
  padding: 20rpx 24rpx;
  margin-right: 16rpx;
  background: #f0faf4;
  border-radius: 16rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.summary-chip:last-child {
  margin-right: 28rpx;
}

.summary-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #2d6a4f;
  line-height: 1.15;
}

.summary-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.toolbar {
  margin-bottom: 24rpx;
}

.btn-add {
  width: 100%;
}

.entry-card {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 72rpx 28rpx 28rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #52b788;
  box-shadow: 0 2rpx 10rpx rgba(45, 106, 79, 0.06);
  box-sizing: border-box;
}

.card-del {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  color: #b91c1c;
  font-size: 32rpx;
  background: #fef2f2;
  z-index: 2;
}

.entry-card:active {
  opacity: 0.92;
}

.entry-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b4332;
  margin-bottom: 8rpx;
}

.entry-preview {
  font-size: 24rpx;
  color: #4a6b58;
  line-height: 1.45;
}
