.diary-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: linear-gradient(180deg, #eaf4ef 0%, #f7f7f5 40%);
  box-sizing: border-box;
}

.diary-hero {
  background: #f0faf4;
  border: 2rpx solid #c5e0d0;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.diary-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #1b5e3b;
  background: #c8e6d4;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.diary-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1b4332;
  margin-bottom: 12rpx;
}

.diary-desc {
  font-size: 24rpx;
  color: #4a6b58;
  line-height: 1.55;
}

.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.summary-head {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b4332;
}

.summary-sub {
  margin-top: 6rpx;
  margin-bottom: 20rpx;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.summary-item {
  width: calc(50% - 8rpx);
  background: #f0faf4;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.summary-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #2d6a4f;
  line-height: 1.2;
}

.summary-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.summary-extra {
  margin-top: 16rpx;
  font-size: 22rpx;
}

.toolbar {
  margin-bottom: 24rpx;
}

.btn-add {
  width: 100%;
}

.entry-card {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #52b788;
  box-shadow: 0 2rpx 10rpx rgba(45, 106, 79, 0.06);
}

.entry-card:active {
  opacity: 0.88;
}

.entry-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b4332;
  margin-bottom: 8rpx;
}

.entry-preview {
  font-size: 24rpx;
  color: #4a6b58;
  line-height: 1.45;
}

.entry-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e8f0eb;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.act-hint {
  font-size: 22rpx;
  color: #7a9a88;
}

.btn-mini-danger {
  margin: 0;
  background: #fff;
  color: #b91c1c;
  border: 2rpx solid #fecaca;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 6rpx 18rpx;
}

.btn-mini-danger::after {
  border: none;
}
