<view class="feedback-page">
  <view class="field">
    <view class="label">问题或建议</view>
    <textarea
      class="textarea"
      placeholder="写下你遇到的问题或想说的话"
      value="{{message}}"
      maxlength="1000"
      bindinput="onMessage"
      auto-height
    />
  </view>
  <view class="field">
    <view class="label">联系方式 <text class="opt">选填</text></view>
    <input
      class="input"
      placeholder="方便回你时填写"
      value="{{contact}}"
      maxlength="60"
      bindinput="onContact"
    />
  </view>
  <button class="btn-primary btn-block" bindtap="onSubmit">提交反馈</button>
</view>
