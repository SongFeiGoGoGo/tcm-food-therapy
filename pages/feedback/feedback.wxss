.feedback-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
  background: #F7F4EF;
}

.field {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #E2D0B8;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3420;
  margin-bottom: 16rpx;
}

.opt {
  font-weight: 400;
  font-size: 22rpx;
  color: #A67C52;
  margin-left: 8rpx;
}

.textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 16rpx 20rpx;
  background: #F6F1EA;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input {
  padding: 16rpx 20rpx;
  background: #F6F1EA;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-block {
  width: 100%;
  margin-top: 8rpx;
}
