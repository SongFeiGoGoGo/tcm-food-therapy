.hero {
  margin-bottom: 32rpx;
  padding: 8rpx 0 16rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1b4332;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

.mode-tag {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #92400e;
  background: #fef3c7;
  border-radius: 8rpx;
}

.mode-tag.cloud {
  color: #065f46;
  background: #d1fae5;
}

.symptom-item {
  active-opacity: 0.85;
}

.symptom-item:active {
  opacity: 0.85;
}

.symptom-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.symptom-icon {
  font-size: 44rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

.symptom-body {
  flex: 1;
  min-width: 0;
}

.arrow {
  font-size: 40rpx;
  color: #9ca3af;
  line-height: 1.2;
  flex-shrink: 0;
}

.footer-actions {
  margin-top: 16rpx;
  text-align: center;
}

.link-fav {
  color: #2d6a4f;
  font-size: 28rpx;
  text-decoration: underline;
}

.notes-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  margin-bottom: 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f6ead7 0%, #efe0c8 100%);
  border: 2rpx solid #e2d0b0;
}
.notes-entry:active { opacity: 0.9; }
.notes-entry-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5c3d1e;
  margin-bottom: 6rpx;
}
.notes-entry-desc {
  font-size: 22rpx;
  color: #8a7355;
}
.notes-entry-arrow {
  font-size: 44rpx;
  color: #a89070;
  padding-left: 12rpx;
}
.section-cap {
  font-size: 24rpx;
  color: #6b7280;
  margin: 8rpx 0 16rpx 8rpx;
}

.notes-entry-hover { opacity: 0.9; }
