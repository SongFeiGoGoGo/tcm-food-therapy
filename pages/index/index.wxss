.home-page {
  padding-top: 24rpx;
}

.banner-swiper {
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.banner-slide {
  position: relative;
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #1b4332;
}

.banner-fallback {
  height: 360rpx;
  box-sizing: border-box;
  padding: 36rpx 32rpx 64rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  color: #ffffff;
  background: linear-gradient(160deg, #1b4332 0%, #2d6a4f 58%, #40916c 100%);
}

.banner-fallback-empty {
  border-radius: 20rpx;
  margin-bottom: 28rpx;
}

.banner-kicker {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  opacity: 0.85;
  margin-bottom: 12rpx;
}

.banner-fallback-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
}

.banner-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 56rpx 28rpx 56rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  background: linear-gradient(180deg, rgba(27, 67, 50, 0) 0%, rgba(27, 67, 50, 0.78) 100%);
}

.almanac {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.almanac-gz {
  font-size: 36rpx;
  font-weight: 700;
  color: #1b4332;
  line-height: 1.4;
}

.almanac-solar {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.almanac-term {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #2d6a4f;
}

.almanac-term.is-today {
  font-weight: 700;
  color: #1b4332;
}

.almanac-near {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #40916c;
}

.feature-list {
  margin-bottom: 8rpx;
}

.feature-card {
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f3eadb;
}

.feature-img {
  width: 100%;
  display: block;
}

.feature-fallback {
  min-height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5c3d1e;
  font-size: 34rpx;
  font-weight: 700;
  background: #f6ead7;
}

.home-intro {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.home-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1b4332;
  margin-bottom: 12rpx;
}

.home-desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

.mode-tag {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #92400e;
  background: #fef3c7;
  border-radius: 8rpx;
}

.mode-tag.cloud {
  color: #065f46;
  background: #d1fae5;
}
