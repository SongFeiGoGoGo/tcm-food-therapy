<view class="container home-page">
  <swiper
    wx:if="{{banners.length}}"
    class="banner-swiper"
    indicator-dots
    indicator-color="rgba(255,255,255,0.45)"
    indicator-active-color="#ffffff"
    autoplay
    circular
    interval="{{4000}}"
    duration="{{450}}"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="banner-slide" data-link="{{item.link}}" catchtap="onBannerTap">
        <image
          wx:if="{{item.image && !item.imgError}}"
          class="banner-img"
          src="{{item.image}}"
          mode="aspectFill"
          data-index="{{index}}"
          binderror="onBannerError"
        />
        <view wx:else class="banner-fallback">
          <view class="banner-kicker">占位</view>
          <view class="banner-fallback-title">{{item.title || '中医食疗'}}</view>
        </view>
        <view class="banner-caption" wx:if="{{item.image && !item.imgError && item.title}}">{{item.title}}</view>
      </view>
    </swiper-item>
  </swiper>
  <view class="banner-fallback banner-fallback-empty" wx:else>
    <view class="banner-kicker">占位</view>
    <view class="banner-fallback-title">暂无轮播</view>
  </view>

  <view class="almanac" wx:if="{{cal && cal.line}}">
    <view class="almanac-gz">{{cal.line}}</view>
    <view class="almanac-solar">公历 {{cal.solarText}}</view>
    <view class="almanac-term {{cal.termToday ? 'is-today' : ''}}">{{cal.termText}}</view>
    <view class="almanac-near" wx:if="{{cal.nearText}}">{{cal.nearText}}</view>
  </view>

  <view class="feature-list">
    <view
      class="feature-card"
      wx:for="{{cards}}"
      wx:key="id"
      data-link="{{item.link}}"
      catchtap="onBannerTap"
    >
      <image
        wx:if="{{item.image && !item.imgError}}"
        class="feature-img"
        src="{{item.image}}"
        mode="widthFix"
        data-index="{{index}}"
        binderror="onCardError"
      />
      <view wx:else class="feature-fallback">{{item.title}}</view>
    </view>
  </view>

  <view class="home-intro">
    <view class="home-title">中医食疗助手</view>
    <view class="home-desc">快来开启你的养生记录打卡吧</view>
    <view class="mode-tag cloud" wx:if="{{cloudReady}}">云开发已连接</view>
  </view>
</view>
