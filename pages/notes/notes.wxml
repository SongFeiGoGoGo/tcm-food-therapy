<view class="notes-page">
  <view class="notes-hero">
    <view class="notes-badge">学习笔记</view>
    <view class="notes-title">中医小笔记</view>
    <view class="notes-desc">读书时整理的方子与用法，已改写成个人理解，并注明来源。也可自己新增笔记。理论讨论，不替代面诊。</view>
  </view>

  <view class="toolbar">
    <button class="btn-primary btn-add" bindtap="onAdd">写笔记</button>
  </view>

  <view
    class="note-card {{item.isUser ? 'note-card-user' : ''}}"
    wx:for="{{notes}}"
    wx:key="key"
    bindtap="onTap"
    data-id="{{item.id}}"
    data-user="{{item.isUser}}"
    data-recipe="{{item.recipeId}}"
  >
    <view class="note-top">
      <text class="note-icon">{{item.icon}}</text>
      <view class="note-meta">
        <view class="note-name-row">
          <view class="note-name">{{item.name}}</view>
          <text class="note-tag {{item.isUser ? 'tag-user' : 'tag-seed'}}">{{item.badge}}</text>
        </view>
        <view class="note-summary">{{item.summary}}</view>
      </view>
    </view>
    <view class="note-foot">{{item.foot}}</view>
  </view>

  <view class="empty" wx:if="{{!loading && !notes.length}}">暂无笔记</view>
  <view class="disclaimer">理论讨论，不替代面诊。体质因人而异，不适请及时就医。</view>
</view>
