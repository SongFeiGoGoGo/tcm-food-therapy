<view class="notes-page">
  <view class="notes-hero">
    <view class="notes-badge">说hao hua</view>
    <view class="notes-title">有话说</view>
    <view class="notes-desc">希望在科技飞速发展的当下你仍然不忘记用文字记录自己，仍然有话说。准确、正确的表述和表达自己比拍一张照留念难多了</view>
  </view>

  <view class="toolbar">
    <button class="btn-primary btn-add" catchtap="onAdd">写日记</button>
  </view>

  <view
    class="note-card {{item.isUser ? 'note-card-user' : ''}}"
    wx:for="{{notes}}"
    wx:key="key"
    data-id="{{item.id}}"
    data-user="{{item.isUser}}"
    data-recipe="{{item.recipeId}}"
    catchtap="onTap"
  >
    <view
      wx:if="{{item.isUser}}"
      class="card-del"
      data-id="{{item.id}}"
      catchtap="onDeleteUser"
    >删除</view>
    <view
      wx:else
      class="card-del"
      data-id="{{item.id}}"
      catchtap="onHideBuiltin"
    >删除</view>
    <view class="note-top">
        <text class="note-icon">{{item.icon}}</text>
        <view class="note-meta">
          <view class="note-name-row">
            <view class="note-name">{{item.name}}</view>
            <text class="note-tag {{item.isUser ? 'tag-user' : 'tag-seed'}}">{{item.badge}}</text>
          </view>
          <view class="note-summary" wx:if="{{item.summary}}">{{item.summary}}</view>
          <view class="note-herbs" wx:if="{{item.herbLine}}">{{item.herbLine}}</view>
        </view>
      </view>
      <view class="note-foot" wx:if="{{item.foot}}">{{item.foot}}</view>
  </view>

  <view class="empty" wx:if="{{!loading && !notes.length}}">暂无日记</view>
</view>
