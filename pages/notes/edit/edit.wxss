.edit-page {
  min-height: 100vh;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F7F4EF;
  box-sizing: border-box;
}

.composer {
  flex: 1;
  padding: 36rpx 48rpx 0;
  box-sizing: border-box;
}

.when {
  font-size: 24rpx;
  color: #A67C52;
  letter-spacing: 2rpx;
  margin-bottom: 36rpx;
}

.title-input {
  width: 100%;
  height: 72rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #4A3420;
  margin-bottom: 12rpx;
  background: transparent;
}

.body-input {
  width: 100%;
  font-size: 34rpx;
  line-height: 1.75;
  color: #4A3420;
  background: transparent;
  box-sizing: border-box;
}

.ph {
  color: #c4b09a;
  font-weight: 400;
}

.dock {
  padding: 12rpx 48rpx 40rpx;
}

.more-toggle {
  font-size: 24rpx;
  color: #A67C52;
  margin-bottom: 12rpx;
}

.more-box {
  margin-bottom: 16rpx;
  padding: 16rpx 0;
  border-top: 2rpx solid #eadfce;
}

.more-line {
  font-size: 24rpx;
  color: #7a6548;
  line-height: 1.5;
}

.save-btn {
  width: 100%;
  background: #6B4F2A;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 8rpx 0;
}

.save-btn::after {
  border: none;
}

.delete-link {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #b91c1c;
}
