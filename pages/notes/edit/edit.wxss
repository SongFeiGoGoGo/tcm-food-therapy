.edit-page {
  min-height: 100vh;
  padding: 28rpx 40rpx 80rpx;
  background: #F7F4EF;
  box-sizing: border-box;
}

.when {
  font-size: 24rpx;
  color: #A67C52;
  letter-spacing: 1rpx;
  margin-bottom: 28rpx;
}

.title-input {
  width: 100%;
  font-size: 44rpx;
  font-weight: 700;
  color: #4A3420;
  line-height: 1.35;
  margin-bottom: 20rpx;
}

.body-input {
  width: 100%;
  min-height: 480rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: #4A3420;
  box-sizing: border-box;
}

.ph {
  color: #c4b09a;
  font-weight: 400;
}

.more-toggle {
  margin: 12rpx 0 28rpx;
  font-size: 26rpx;
  color: #A67C52;
}

.field {
  background: #fffdf8;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.label {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A3420;
  margin-bottom: 12rpx;
}

.opt {
  font-weight: 400;
  font-size: 22rpx;
  color: #a89070;
  margin-left: 8rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  background: #f5efe4;
  border: 2rpx solid transparent;
}

.chip.on {
  background: #6B4F2A;
  border-color: #6B4F2A;
}

.input {
  padding: 14rpx 18rpx;
  background: #F7F4EF;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 14rpx 18rpx;
  background: #F7F4EF;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-block {
  width: 100%;
  margin-top: 12rpx;
}

.btn-danger {
  background: transparent;
  color: #b91c1c;
  border: none;
  font-size: 28rpx;
  padding: 18rpx 36rpx;
  margin-top: 8rpx;
}

.btn-danger::after {
  border: none;
}

.herb-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.herb-name,
.herb-amount {
  min-width: 0;
}

.herb-name {
  flex: 1.3;
}

.herb-amount {
  flex: 1;
}

.herb-remove {
  flex-shrink: 0;
  color: #b91c1c;
  font-size: 24rpx;
  padding: 8rpx 4rpx;
}

.btn-add-herb {
  margin-top: 8rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.slot-text {
  min-height: 120rpx;
}
