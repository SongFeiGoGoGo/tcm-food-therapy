<view class="edit-page">
  <view class="field">
    <view class="label">标题</view>
    <input
      class="input"
      placeholder="例如：某食疗思路笔记"
      value="{{title}}"
      maxlength="40"
      bindinput="onTitleInput"
    />
  </view>

  <view class="field">
    <view class="label">图标 <text class="opt">选填</text></view>
    <view class="chips">
      <view
        wx:for="{{iconOpts}}"
        wx:key="*this"
        class="chip {{icon === item ? 'on' : ''}}"
        data-v="{{item}}"
        bindtap="onPickIcon"
      >{{item}}</view>
    </view>
  </view>

  <view class="field">
    <view class="label">摘要 <text class="opt">选填</text></view>
    <input
      class="input"
      placeholder="一句话概括，列表里会显示"
      value="{{summary}}"
      maxlength="80"
      bindinput="onSummaryInput"
    />
  </view>

  <view class="field">
    <view class="label">正文 / 用法要点 <text class="opt">选填</text></view>
    <textarea
      class="textarea"
      placeholder="写下你的理解、用法要点或配伍思路（个人学习笔记，勿照录商业书原文）"
      value="{{content}}"
      maxlength="2000"
      bindinput="onContentInput"
      auto-height
    />
  </view>

  <view class="field">
    <view class="label">来源备注 <text class="opt">选填</text></view>
    <input
      class="input"
      placeholder="个人学习笔记"
      value="{{source}}"
      maxlength="60"
      bindinput="onSourceInput"
    />
  </view>

  <button class="btn-primary btn-block" bindtap="onSave">保存</button>
  <button wx:if="{{isEdit}}" class="btn-danger btn-block" bindtap="onDelete">删除这条</button>

  <view class="disclaimer">理论讨论，不替代面诊。这里是个人学习笔记，不作诊断或用药依据。</view>
</view>
