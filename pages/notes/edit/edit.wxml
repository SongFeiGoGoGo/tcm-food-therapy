<view class="edit-page" wx:if="{{!blocked}}">
  <view class="composer">
    <view class="when">{{whenText}}</view>
    <input
      class="title-input"
      placeholder="标题（可选）"
      placeholder-class="ph"
      value="{{title}}"
      maxlength="40"
      bindinput="onTitleInput"
      confirm-type="next"
    />
    <textarea
      class="body-input"
      style="height: {{bodyHeight}}px;"
      placeholder="这一刻想写点什么…"
      placeholder-class="ph"
      value="{{content}}"
      maxlength="4000"
      bindinput="onContentInput"
      show-confirm-bar="{{false}}"
    />
  </view>

  <view class="dock">
    <view class="more-toggle" wx:if="{{canShowMore}}" bindtap="onToggleMore">{{showMore ? '收起' : '更多'}}</view>
    <view wx:if="{{showMore && canShowMore}}" class="more-box">
      <view class="more-line" wx:for="{{herbs}}" wx:key="_key" wx:if="{{item.name || item.amount}}">{{item.name}} {{item.amount}}</view>
      <view class="more-line" wx:for="{{slots}}" wx:key="key" wx:if="{{item.value}}">{{item.label}}：{{item.value}}</view>
      <view class="more-line" wx:if="{{summary}}">{{summary}}</view>
    </view>
    <button class="save-btn" bindtap="onSave">保存</button>
    <view wx:if="{{isEdit}}" class="delete-link" bindtap="onDelete">删除</view>
  </view>
</view>
