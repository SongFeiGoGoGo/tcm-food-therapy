.notes-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: linear-gradient(180deg, #f3efe6 0%, #f7f7f5 40%);
  box-sizing: border-box;
}

.notes-hero {
  background: #fffaf0;
  border: 2rpx solid #e8dcc8;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.notes-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #8b5e34;
  background: #f0e0c8;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.notes-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #5c3d1e;
  margin-bottom: 12rpx;
}

.notes-desc {
  font-size: 24rpx;
  color: #7a6548;
  line-height: 1.55;
}

.toolbar {
  margin-bottom: 24rpx;
}

.btn-add {
  width: 100%;
}

.note-card {
  background: #fffdf8;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #c4a574;
  box-shadow: 0 2rpx 10rpx rgba(92, 61, 30, 0.06);
}

.note-card-user {
  border-left-color: #8b5e34;
  background: #fffaf3;
}

.note-card:active {
  opacity: 0.88;
}

.note-top {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.note-icon {
  font-size: 40rpx;
  line-height: 1.2;
}

.note-meta {
  flex: 1;
  min-width: 0;
}

.note-name-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.note-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #5c3d1e;
  min-width: 0;
}

.note-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  line-height: 1.4;
  margin-top: 4rpx;
}

.tag-seed {
  color: #8a7355;
  background: #f0e6d6;
}

.tag-user {
  color: #fff;
  background: #8b5e34;
}

.note-summary {
  font-size: 24rpx;
  color: #8a7355;
  line-height: 1.45;
}

.note-foot {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #a89070;
}

.note-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #efe4d2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.act-hint {
  font-size: 22rpx;
  color: #a89070;
}

.btn-mini-danger {
  margin: 0;
  background: #fff;
  color: #b91c1c;
  border: 2rpx solid #fecaca;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 6rpx 18rpx;
}

.btn-mini-danger::after {
  border: none;
}
